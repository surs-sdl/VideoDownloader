{
  "manifest_version": 3,
  "name": "Instant Video Downloader",
  "version": "1.1",
  "description": "Extracts video source URL with thumbnail preview, then downloads immediately.",
  "permissions": ["activeTab", "scripting", "downloads"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Download video now",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "host_permissions": ["<all_urls>"]
}