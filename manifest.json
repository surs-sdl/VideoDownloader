{
  "manifest_version": 3,
  "name": "Instant Video Downloader",
  "version": "1.0.0",
  "description": "A lightweight Chrome extension for detecting and downloading direct HTML5 video sources.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Instant Video Downloader",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}